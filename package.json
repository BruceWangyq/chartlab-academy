{
  "name": "chartlab-academy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:built": "playwright test",
    "test:all": "pnpm check && pnpm audit:lighthouse && pnpm test:e2e:built",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "security:audit": "pnpm audit --audit-level high",
    "audit:lighthouse": "node scripts/verify-lighthouse.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "content:export": "tsx scripts/export-sanity-seed.ts",
    "sanity:deploy": "sanity deploy",
    "readiness:production": "node --env-file-if-exists=.env.local scripts/verify-production-readiness.mjs",
    "verify:production": "node --env-file-if-exists=.env.local scripts/verify-production.mjs"
  },
  "dependencies": {
    "@sanity/client": "^8.4.0",
    "@sanity/vision": "^6.11.0",
    "@sentry/nextjs": "^10.72.0",
    "drizzle-orm": "^0.45.2",
    "hls.js": "^1.7.1",
    "jose": "^6.2.10",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-sanity": "^13.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "sanity": "^6.11.0",
    "stripe": "^22.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
